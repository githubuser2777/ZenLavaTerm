# Maintainer: ZenLavaTerm Contributors <https://github.com/githubuser2777/ZenLavaTerm>
pkgname=lavaterm-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="A terminal-native ambient lava lamp and metaball visualizer (precompiled binary)"
arch=('x86_64')
url="https://github.com/githubuser2777/ZenLavaTerm"
license=('MIT')
depends=('gcc-libs')
provides=('lavaterm')
conflicts=('lavaterm' 'lavaterm-git')
source=("$pkgname-$pkgver.deb::$url/releases/download/v$pkgver/ZenLavaTerm-v$pkgver-linux-x86_64.deb")
# Note: sha256sums is set to 'SKIP' in repo template. When publishing a release to AUR,
# run `updpkgsums` or replace 'SKIP' with the SHA-256 hash of the release artifact.
sha256sums=('SKIP')

package() {
  # Extract data archive from deb (handles data.tar.gz, data.tar.xz, data.tar.zst)
  bsdtar -xf "$srcdir/$pkgname-$pkgver.deb"
  local data_archive=(data.tar.*)
  if [[ -f "${data_archive[0]}" ]]; then
    bsdtar -xf "${data_archive[0]}" -C "$pkgdir/"
  fi
}
