# Maintainer: ZenLavaTerm Contributors <https://github.com/githubuser2777/ZenLavaTerm>
pkgname=lavaterm
pkgver=1.0.1
pkgrel=1
pkgdesc="A terminal-native ambient lava lamp and metaball visualizer"
arch=('x86_64')
url="https://github.com/githubuser2777/ZenLavaTerm"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
provides=('lavaterm')
conflicts=('lavaterm-bin' 'lavaterm-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('__SOURCE_SHA__')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/lavaterm" "$pkgdir/usr/bin/lavaterm"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
